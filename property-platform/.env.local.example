# Копирай този файл на .env.local и попълни със стойностите от твоя
# Supabase проект: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI помощникът (плаващата 3D иконка). Без този ключ иконката пак стои и
# се натиска, но панелът показва само преки пътища из сайта вместо чат.
# Ключът се взема от console.anthropic.com -> API keys и се слага във
# Vercel като Secret — НИКОГА в кода и никога в NEXT_PUBLIC_ променлива.
ANTHROPIC_API_KEY=

# Сол за хеширане на IP адресите при дневния лимит на помощника.
# Произволен таен низ; ако липсва, се ползва CRON_SECRET.
ASSISTANT_IP_SALT=

# Ключ, с който дневната задача (/api/cron/expire-listings) пуска
# напомнянията в базата. Същата стойност стои в Supabase, таблица
# private.settings, ред reminders_secret (виж 20261004090000_lock_listing_reminders.sql).
# Secret във Vercel. Без него напомнянията не тръгват.
REMINDERS_DB_SECRET=

# Meta (Facebook) Pixel — за рекламите във Facebook/Instagram. Номерът
# на пиксела не е таен (вижда се в кода на всяка страница), затова е
# NEXT_PUBLIC_ и Config, не Secret. Без него пикселът не се зарежда
# изобщо — нормалното състояние за dev и preview.
NEXT_PUBLIC_FB_PIXEL_ID=

# „Касата“ за AI агенти по протокола x402 (платените адреси под /api/agent/*).
# Виж docs/X402-АГЕНТИ.md и docs/РЪЧНИ-СТЪПКИ.md, раздел A7.
# Адресът на портфейла, в който пристигат парите (USDC). Публичен е — Config,
# не Secret. Без него платените адреси отговарят 503 „не е включено“.
X402_PAY_TO=
# Мрежа: eip155:84532 = Base Sepolia (тестова, парите са играчка; по подразбиране),
# eip155:8453 = Base (истински пари). Сменя се с една дума, когато решиш.
X402_NETWORK=eip155:84532
# Посредникът, който проверява и сетълва плащанията. Публичният на Coinbase е безплатен.
X402_FACILITATOR_URL=https://x402.org/facilitator
# САМО за тестовия скрипт (npm run x402:test), никога във Vercel: частен ключ
# на отделен ТЕСТОВ портфейл, от който скриптът плаща.
X402_CLIENT_PRIVATE_KEY=
