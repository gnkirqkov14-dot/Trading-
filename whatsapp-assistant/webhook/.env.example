# Всички стойности се копират от таблото на Meta — виж docs/РЪЧНИ-СТЪПКИ.md.
# Този файл е само пример; истинските стойности се пишат във Vercel.

# Дума, която си измисляш сам. Пише се на две места: тук и в Meta,
# в полето "Verify token". Трябва да съвпадат буква по буква.
WHATSAPP_VERIFY_TOKEN=измисли-дълга-дума-тук

# App Secret от Meta → App settings → Basic. С него се проверява, че
# заявката наистина идва от Meta, а не от случаен човек по интернет.
WHATSAPP_APP_SECRET=

# Временният токен от таблото на WhatsApp (валиден 24 часа).
WHATSAPP_ACCESS_TOKEN=

# Версията на Graph API, изписана в примера на Meta (напр. v21.0).
GRAPH_API_VERSION=v21.0

# По избор. Без него ботът отговаря с фиксирано изречение —
# достатъчно, за да се види, че връзката работи.
ANTHROPIC_API_KEY=
