# Копирай като .env.local за локална работа. Без Supabase ключове сайтът
# чете от data/db.json, който се пълни с `npm run import -- 2026-10-01 2026-10-03`.

# Адрес и име на сайта (Config, не Secret).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Нови поръчки
NEXT_PUBLIC_SUPPORT_EMAIL=

# Supabase: Project Settings -> API. Service role ключът е ТАЕН (Secret):
# само на сървъра, никога в NEXT_PUBLIC_ променлива.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Пази дневните задачи (внос и известия). Произволен таен низ.
CRON_SECRET=

# Известия по имейл през Resend. Без ключа записването е изключено.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Плащания от AI агенти по x402 (виж docs/РЪЧНИ-СТЪПКИ.md, раздел 5).
X402_PAY_TO=
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
# Само за тестовия скрипт (npm run x402:test), никога във Vercel.
X402_CLIENT_PRIVATE_KEY=
