# Copy to .env and fill in what you have. The demo runs fine with none of these set —
# every module falls back to a rule-based / mock implementation when a key is missing.

# LLM reasoning (decision synthesis + natural-language explanations).
# Without this, decision_engine.py falls back to a deterministic rule-based reasoner.
ANTHROPIC_API_KEY=

# Optional: override the default Claude model used for decision synthesis.
ANTHROPIC_MODEL=claude-sonnet-5

# Crypto market data (CoinGecko). The free "demo" tier works without a key for
# the endpoints this app uses; set this if you have a Demo/Pro key to raise rate limits.
COINGECKO_API_KEY=

# Financial news. Without a key, news.py serves rotating mock headlines tagged
# with sentiment/relevance so the rest of the pipeline has real input to react to.
NEWS_API_KEY=
NEWS_API_BASE=https://gnews.io/api/v4

# Public figures / statements tracking. Same mock-fallback pattern as news.
STATEMENTS_API_KEY=

# Database. Defaults to a local SQLite file — swap for a Postgres URL in production,
# e.g. postgresql+psycopg://user:pass@host:5432/trading
DATABASE_URL=sqlite:///./trading_demo.db

# Paper trading defaults
STARTING_CAPITAL=100000
MAX_POSITION_PCT=0.15
DEFAULT_STOP_LOSS_PCT=0.08
DEFAULT_TAKE_PROFIT_PCT=0.20

# Future "approval mode" (see docs/ARCHITECTURE.md). In this demo the agent is
# fully autonomous; APPROVAL_THRESHOLD_PCT is stored/enforced in code already so
# flipping AUTONOMOUS_MODE off later is a config change, not a rewrite.
AUTONOMOUS_MODE=true
APPROVAL_THRESHOLD_PCT=0.10

# How often the scheduler runs the full analysis pipeline, in minutes.
ANALYSIS_INTERVAL_MINUTES=240
